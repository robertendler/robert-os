# =====================================================================
# Robert-OS Zugangsdaten
# ---------------------------------------------------------------------
# Kopiere diese Datei nach ".env" und trage deine echten Werte ein.
# Die Datei ".env" wird NIE ins Internet hochgeladen (siehe .gitignore).
# =====================================================================

# --- 1. Anthropic (die KI) -------------------------------------------
# Von console.anthropic.com -> API Keys. Beginnt mit "sk-ant-..."
ANTHROPIC_API_KEY=

# --- 2. Telegram (Benachrichtigungen aufs Handy) ---------------------
# Vom BotFather in der Telegram-App. Sieht aus wie "12345678:AAH..."
TELEGRAM_BOT_TOKEN=
# Deine persoenliche Chat-ID. Ermittelbar mit:  robertos chat-id
TELEGRAM_CHAT_ID=

# =====================================================================
# Ab hier: sinnvolle Voreinstellungen. Muss man nicht anfassen.
# =====================================================================

# Welches KI-Modell benutzt wird.
ROBERTOS_MODEL=claude-opus-5

# Wie gruendlich die KI nachdenken soll: low, medium, high, xhigh, max
# "medium" ist der guenstige Alltagsmodus, "high" denkt gruendlicher und
# kostet mehr.
ROBERTOS_EFFORT=medium

# Speicherort der Datenbank (relativ zum Projektordner)
ROBERTOS_DB=data/robertos.db

# Zeitzone fuer Datums- und Zeitangaben
ROBERTOS_TZ=Europe/Berlin

# Sicherheitsnetz: Wenn ein Lauf mehr als so viele Cent kosten wuerde,
# bricht er ab. 0 = kein Limit.
ROBERTOS_MAX_CENTS_PER_RUN=0

# Testmodus: 1 = es wird keine echte KI aufgerufen und nichts an Telegram
# gesendet. Praktisch zum Ausprobieren ohne Kosten.
ROBERTOS_DRY_RUN=0
